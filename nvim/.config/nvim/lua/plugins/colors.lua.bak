return {
  {
    "craftzdog/solarized-osaka.nvim",
    lazy = false,
    priority = 1000,
    opts = {
      transparent = false,
      terminal_colors = true,
      style = "dark",
    },
    config = function(_, opts)
      require("solarized-osaka").setup(opts)
      vim.cmd.colorscheme("solarized-osaka")

      -- Personnalisation des inlay hints : italique et fond ajusté
      vim.api.nvim_set_hl(0, "LspInlayHint", {
        italic = true,
        bg = "#001f26", -- Décommente et mets une couleur hex si tu veux un fond spécifique
        -- bg = "NONE", -- Utilise ceci si tu veux supprimer complètement le fond (fond transparent)
        fg = "#657b83",
      })
    end,
  },
}
