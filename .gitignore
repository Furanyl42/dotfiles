# Ignore OS and system garbage
.DS_Store
Thumbs.db

# Ignore LazyVim state, plugin installs, and lockfiles (they re-install on new machines)
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/plugin/
nvim/.config/nvim/undo/
nvim/.config/nvim/.netrwhist

# Ignore tmux plugin installations (TPM re-downloads them automatically)
tmux/.tmux/plugins/

# Ignore sensitive log/history files
*.log
*.tmp
